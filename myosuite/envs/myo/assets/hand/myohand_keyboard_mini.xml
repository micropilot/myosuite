<mujoco model="MyoHand typing on a SMALL QWERTY keyboard (MJX/Warp)">
<!-- =================================================
    Reduced MyoHand + QWERTY keyboard scene for the GPU (MJX / MuJoCo-Warp)
    single-key press task (milestone 1). Identical to myohand_keyboard.xml but
    with a small right-hand key subset (qwerty_keyboard_mini.xml, 20 keys, no
    touch sensors) so `mjx.put_model` succeeds and per-env contact memory stays
    small enough to scale env count on a 24GB card.
    - Right MyoHand (39 muscles) on a 3-DoF prismatic base (base_x/y/z).
    - Each key is a spring-loaded slider box; a keypress = slider qpos past
      press_th of its travel (read directly from qpos, no touch sensor needed).
    Base actuators are position servos appended after the 39 muscle actuators.
====================================================== -->

    <include file="../../../../simhive/myo_sim/hand/assets/myohand_assets.xml"/>
    <include file="../../../../simhive/myo_sim/scene/myosuite_scene.xml"/>
    <compiler meshdir='../../../../simhive/myo_sim/' texturedir='../../../../simhive/myo_sim/'/>

    <visual>
        <global offwidth="1280" offheight="960"/>
    </visual>

    <worldbody>
        <!-- Floating base: 3 prismatic joints centered on the mount pose. -->
        <body name="hand_mount" pos="0 0 0">
            <joint name="base_x" type="slide" axis="1 0 0" range="-0.14 0.14" damping="50" armature="0.1"/>
            <joint name="base_y" type="slide" axis="0 1 0" range="-0.08 0.08" damping="50" armature="0.1"/>
            <joint name="base_z" type="slide" axis="0 0 1" range="-0.01 0.08" damping="50" armature="0.1"/>
            <include file="../../../../simhive/myo_sim/hand/assets/myohand_body.xml"/>
        </body>

        <!-- Target marker: a mocap body moved onto the selected key by the env. -->
        <body name="key_target" mocap="true" pos="0 0 1.4">
            <site name="key_target_site" pos="0 0 0" size="0.006" rgba="0.9 0.1 0.1 0.9"/>
        </body>

        <!-- Invisible hand barrier at the key-top plane. contype=0/conaffinity=1
             => collides with every hand geom on the default bit 1 (palm, wrist,
             finger segments) but NOT the fingertip geoms (moved to bit 4 by the
             env) or the keys. -->
        <geom name="hand_barrier" type="box" pos="-0.16 -0.55 1.376"
              size="0.22 0.10 0.001" contype="0" conaffinity="1"
              rgba="0 0 0 0" group="4"/>
    </worldbody>

    <!-- Small QWERTY keyboard (worldbody merged in; no touch sensors) -->
    <include file="qwerty_keyboard_mini.xml"/>

    <actuator>
        <position name="base_x_act" joint="base_x" kp="2000" kv="100" ctrlrange="-0.14 0.14"/>
        <position name="base_y_act" joint="base_y" kp="2000" kv="100" ctrlrange="-0.08 0.08"/>
        <position name="base_z_act" joint="base_z" kp="2000" kv="100" ctrlrange="-0.01 0.08"/>
    </actuator>
</mujoco>
