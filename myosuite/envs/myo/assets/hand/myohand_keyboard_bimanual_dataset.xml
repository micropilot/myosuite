<mujoco model="Two MyoHands typing on a QWERTY keyboard">
<!-- =================================================
    Bimanual typing scene: a right MyoHand and a mirrored left MyoHand
    (generated by mirror_hand.py), each on its own 3-DoF prismatic floating
    base, over a QWERTY keyboard whose keys are spring-loaded touch sliders.
    Actuators: 39 right muscles + 39 left muscles + 6 base position servos.
====================================================== -->

    <include file="../../../../simhive/myo_sim/hand/assets/myohand_assets.xml"/>
    <include file="myohand_assets_left.xml"/>
    <include file="../../../../simhive/myo_sim/scene/myosuite_scene.xml"/>
    <compiler meshdir='../../../../simhive/myo_sim/' texturedir='../../../../simhive/myo_sim/'/>

    <visual>
        <global offwidth="1280" offheight="960"/>
    </visual>

    <worldbody>
        <!-- Right hand over the RIGHT keyboard half (index rests near J). -->
        <body name="hand_mount_R" pos="0.058 0 0">
            <joint name="base_x_R" type="slide" axis="1 0 0" range="-0.14 0.14" damping="50" armature="0.1"/>
            <joint name="base_y_R" type="slide" axis="0 1 0" range="-0.08 0.08" damping="50" armature="0.1"/>
            <joint name="base_z_R" type="slide" axis="0 0 1" range="-0.01 0.08" damping="50" armature="0.1"/>
            <include file="myohand_body_right.xml"/>
        </body>

        <!-- Left hand: mirrored model, mount translated in -x so the hand sits
             over the LEFT keyboard half (index rests near F). -->
        <body name="hand_mount_L" pos="-0.444 0 0">
            <joint name="base_x_L" type="slide" axis="1 0 0" range="-0.14 0.14" damping="50" armature="0.1"/>
            <joint name="base_y_L" type="slide" axis="0 1 0" range="-0.08 0.08" damping="50" armature="0.1"/>
            <joint name="base_z_L" type="slide" axis="0 0 1" range="-0.01 0.08" damping="50" armature="0.1"/>
            <include file="myohand_body_left.xml"/>
        </body>

        <!-- Target marker (mocap; moved onto the selected key by the env). -->
        <body name="key_target" mocap="true" pos="0 0 1.4">
            <site name="key_target_site" pos="0 0 0" size="0.006" rgba="0.9 0.1 0.1 0.9"/>
        </body>

        <!-- Invisible hand barrier at the key-top plane (see unimanual scene). -->
        <geom name="hand_barrier" type="box" pos="-0.16 -0.55 1.376"
              size="0.30 0.10 0.001" contype="0" conaffinity="1"
              rgba="0 0 0 0" group="4"/>
    </worldbody>

    <include file="qwerty_keyboard_dataset.xml"/>

    <actuator>
        <position name="base_x_R_act" joint="base_x_R" kp="2000" kv="100" ctrlrange="-0.14 0.14"/>
        <position name="base_y_R_act" joint="base_y_R" kp="2000" kv="100" ctrlrange="-0.08 0.08"/>
        <position name="base_z_R_act" joint="base_z_R" kp="2000" kv="100" ctrlrange="-0.01 0.08"/>
        <position name="base_x_L_act" joint="base_x_L" kp="2000" kv="100" ctrlrange="-0.14 0.14"/>
        <position name="base_y_L_act" joint="base_y_L" kp="2000" kv="100" ctrlrange="-0.08 0.08"/>
        <position name="base_z_L_act" joint="base_z_L" kp="2000" kv="100" ctrlrange="-0.01 0.08"/>
    </actuator>
</mujoco>
